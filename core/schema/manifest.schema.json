{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eads.local/schema/manifest.schema.json",
  "title": "EADS Core manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lifecycle_state": {
      "type": "string",
      "enum": ["draft", "reviewed", "ratified"]
    },
    "released_at": {
      "type": "string",
      "format": "date"
    },
    "files": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "compatible_schema_versions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "policy_version",
    "lifecycle_state",
    "released_at",
    "files",
    "compatible_schema_versions"
  ],
  "additionalProperties": false
}
